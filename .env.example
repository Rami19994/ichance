# ==========================================
# iCHANCE Platform Configuration Template
# ==========================================

# Network & Server
PORT=3000
HOST=0.0.0.0

# Database Configuration (Supabase)
# Can also be configured dynamically from the Admin Panel
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_service_role_key_here

# Admin Security & Isolation
# Secret path for admin key generation gate (leave empty for random generated gate)
# ICHANCE_GATE_PATH=6a546f34f797ed19196b0d9392ae8979

# Fixed admin key (optional - overrides data/admin.json)
# ICHANCE_ADMIN_KEY=your_secure_admin_password_or_key

# Isolated domain for admin panel (e.g. admin.yourdomain.com)
# ICHANCE_ADMIN_DOMAIN=

# Claim window in minutes for browser-based first-time setup (default: 60)
ICHANCE_CLAIM_WINDOW_MIN=60

# Bots configuration: 0 = disabled (default), 1 = enabled
ICHANCE_BOTS=0

# Storage file location (default: data/players.json)
ICHANCE_DATA=data/players.json
