# ═══════════════════════════════════════════════════════════════════
# LuckyArena — متغيّرات البيئة
#
# انسخ هذا الملف إلى .env واملأ القيم:   cp .env.example .env
#
# ⚠ .env مستثنى في .gitignore — لا ترفعه إلى أي مستودع، فيه أسرارك.
#
# ⚠ على Vercel أو Hostinger: اضبط هذه من لوحة الاستضافة لا من الملف.
#    قيم لوحة الاستضافة تتقدّم على الملف دائماً.
# ═══════════════════════════════════════════════════════════════════

# ── قاعدة البيانات (إلزامي لعمل الحسابات والكاشير) ──────────────────
# من Supabase ← Project Settings ← API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ⚠ المفتاح السرّي وحده. يبدأ بـ sb_secret_ — لا sb_publishable_
#   المفتاح المنشور عامّ بطبيعته ويجعل الخادم يعمل بدور anon، فلا يقرأ
#   التقارير ولا يُفترض أن يلمس الأرصدة.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ── بوابة الإدارة السرّية (إلزامي على Serverless) ────────────────────
# 32 خانة سداسية. رابط بوابتك يصير:  https://نطاقك/<هذه القيمة>
#
# على خادم بقرص دائم يُولَّد تلقائياً ويُحفظ في data/admin-gate.json،
# فيمكن ترك هذا فارغاً. على Vercel لا قرص دائم — فهو إلزامي هنا،
# وبدونه تُعطَّل البوابة عمداً.
#
# ولّد واحداً:  node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ICHANCE_GATE_PATH=

# ── اختياري ────────────────────────────────────────────────────────
# مفتاح إدارة ثابت. اتركه فارغاً: البوابة تولّد مفتاحاً عند كل دخول،
# وهو المقصود. ضبطه هنا يعني مفتاحاً واحداً لا يتغيّر.
ICHANCE_ADMIN_KEY=

# دقائق نافذة إنشاء المفتاح من المتصفح في أول تشغيل
ICHANCE_CLAIM_WINDOW_MIN=60

# اللاعبون الآليون في كروت الحظ — 0 لإيقافهم
ICHANCE_BOTS=1

# مسار ملف البيانات المحلي.
# ⚠ على Vercel يجب أن يكون تحت /tmp — بقيّة النظام للقراءة فقط.
#   مثال:  ICHANCE_DATA=/tmp/ichance/players.json
ICHANCE_DATA=

# ⚠ لا تضبط PORT ولا HOST على Vercel — تديرهما الاستضافة بنفسها،
#   وضبطهما يدوياً قد يمنع الدالة من الاستجابة.
# PORT=3000
# HOST=0.0.0.0
